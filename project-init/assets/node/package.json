{
  "name": "{{NAME}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@{{PNPM_VERSION}}",
  "engines": {
    "node": ">={{NODE_MAJOR}}"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"packages/*/src/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  }
}
